# Rebuild the interface while retaining the installed HarborFM backend/runtime.
# scripts/build-oni-studio.sh supplies an immutable local tag of the running image.
ARG STUDIO_BASE_IMAGE
FROM node:22-bookworm-slim AS frontend
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter shared run build && pnpm --filter web run build

FROM ${STUDIO_BASE_IMAGE} AS studio
USER root
RUN rm -rf /app/server/public && mkdir -p /app/server/public && chown appuser:appuser /app/server/public
COPY --chown=appuser:appuser --from=frontend /app/web/dist/ /app/server/public/
USER appuser
# Inherit ports, environment, entrypoint, command, and volumes from the installed image.
